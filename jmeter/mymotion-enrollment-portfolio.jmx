          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import java.net.URLEncoder
import java.util.Base64
import org.apache.jmeter.protocol.http.control.Cookie

def token = vars.get(&apos;auth_token&apos;)

if (!token || token == &apos;TOKEN_NOT_FOUND&apos;) {
    log.error(&apos;auth_token tidak ditemukan&apos;)
    return
}

def jwtPart = token.split(&apos;\\.&apos;)[1]
def padding = &apos;=&apos; * ((4 - jwtPart.length() % 4) % 4)
def payloadJson = new String(
    Base64.getUrlDecoder().decode(jwtPart + padding),
    &apos;UTF-8&apos;
)

def claims = new JsonSlurper().parseText(payloadJson)

def cookieObject = [
    token    : token,
    userId   : claims.userId,
    partnerId: claims.partnerId,
    username : claims.username,
    email    : claims.email,
    role     : claims.role,
    sessionId: claims.sessionId,
    iat      : claims.iat,
    exp      : claims.exp
]

def cookieValue = URLEncoder.encode(
    JsonOutput.toJson(cookieObject),
    &apos;UTF-8&apos;
)

def cookie = new Cookie(
    &apos;motion_session&apos;,
    cookieValue,
    &apos;example.test&apos;,
    &apos;/&apos;,
    true,
    0L
)

ctx.getCurrentSampler().getCookieManager().add(cookie)

log.info(&apos;motion_session cookie berhasil dibuat secara dinamis&apos;)</stringProp>
