                <stringProp name="Argument.value">{&#xd;
&quot;identifier&quot;: &quot;${__P(motion.username,REPLACE_WITH_LOCAL_USERNAME)}&quot;,&#xd;
&quot;partner&quot;: &quot;PARTNER-DEMO&quot;,&#xd;
&quot;password&quot;: &quot;${__P(motion.password,REPLACE_WITH_LOCAL_PASSWORD)}&quot;&#xd;
}</stringProp>
